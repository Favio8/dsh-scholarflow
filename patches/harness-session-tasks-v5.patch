@@ -0,0 +1,103 @@
+/** Persistent plugin work registration, independent of Agent Loop turns. */
+import { Context, Service } from '@deepseek-ai/cordis'
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type { PluginTaskBinding } from '@deepseek-ai/dsh-session/types'
+import { SessionTitleProviderId } from '@deepseek-ai/dsh-session-title'
+import type {} from '@deepseek-ai/dsh-session-persistence'
+import type {} from '@deepseek-ai/dsh-session-projection-cache'
+
+/** Registered plugin namespace. */
+export type PluginTaskProviderId = Branded<'PluginTaskProviderId'>
+/**
+ * Brand a plugin namespace.
+ * @param value - plugin id.
+ * @returns branded id.
+ */
+export function PluginTaskProviderId(value: string): PluginTaskProviderId { return value as PluginTaskProviderId }
+
+export type { PluginTaskBinding } from '@deepseek-ai/dsh-session/types'
+/** Same-process plugin validator, not an RPC or model tool. */
+export interface PluginTaskProvider {
+  readonly id: PluginTaskProviderId
+  /**
+   * Re-read confirmed binding and title.
+   * @param binding - requested identity.
+   * @param signal - cancellation.
+   * @returns current project title.
+   */
+  validate(binding: PluginTaskBinding, signal: AbortSignal): Promise<{ title: string }>
+}
+
+declare module '@deepseek-ai/cordis' { interface Context { sessionTasks: SessionTasks } }
+
+/** Owns plugin validation, idempotent registration, title ownership and durable acknowledgement. */
+export class SessionTasks extends Service {
+  static inject = ['sessions', 'sessionTitle', 'workspaceRegistry']
+  private readonly providers = new Map<PluginTaskProviderId, PluginTaskProvider>()
+  private readonly queues = new Map<SessionId, Promise<void>>()
+  private readonly disposal = new AbortController()
+
+  /** @param ctx - host session services. */
+  constructor(ctx: Context) {
+    super(ctx, 'sessionTasks')
+    ctx.effect(() => async () => {
+      this.disposal.abort('session task service disposed')
+      await Promise.allSettled([...this.queues.values()])
+    }, 'session task work lifetime')
+  }
+
+  /**
+   * Register a trusted validator.
+   * @param provider - plugin owner.
+   * @returns disposer.
+   */
+  register(provider: PluginTaskProvider): () => void {
+    if (this.providers.has(provider.id)) throw new Error('task provider is already registered')
+    this.providers.set(provider.id, provider)
+    return () => { if (this.providers.get(provider.id) === provider) this.providers.delete(provider.id) }
+  }
+
+  /**
+   * Confirm a plugin-owned task and synchronize its title without running a model.
+   * @param binding - exact project, session and task identities.
+   * @param signal - caller cancellation.
+   * @returns durable registration and accepted title, including manual-name ownership.
+   */
+  async bind(binding: PluginTaskBinding, signal: AbortSignal): Promise<{ registered: true; title: string; manualTitlePreserved: boolean }> {
+    const previous = this.queues.get(binding.sessionId) ?? Promise.resolve()
+    const work = previous.then(async () => {
+      const activeSignal = AbortSignal.any([signal, this.disposal.signal])
+      activeSignal.throwIfAborted()
+      const provider = this.providers.get(binding.pluginId)
+      if (!provider) throw new Error('task provider is unavailable')
+      const session = this.ctx.sessions.get(binding.sessionId)
+      const workspace = this.ctx.workspaceRegistry.get(binding.workspaceId)
+      if (!session || !workspace?.sessionIds.includes(binding.sessionId)) throw new Error('task session is outside its workspace')
+      const workspacePath = workspace.path
+      const observed = this.ctx.sessionTitle.get(session)?.eventSeq
+      const confirmed = await provider.validate(binding, activeSignal)
+      activeSignal.throwIfAborted()
+      if (this.providers.get(binding.pluginId) !== provider || this.ctx.sessions.get(binding.sessionId) !== session
+        || !this.ctx.workspaceRegistry.get(binding.workspaceId)?.sessionIds.includes(binding.sessionId)
+        || this.ctx.workspaceRegistry.get(binding.workspaceId)?.path !== workspacePath) throw new Error('task binding changed during validation')
+      const existing = session.getPluginTaskBinding()
+      if (existing && (existing.data.pluginId !== binding.pluginId || existing.data.projectId !== binding.projectId
+        || existing.data.workspaceId !== binding.workspaceId)) throw new Error('session already belongs to another task project')
+      const registration = !existing || existing.data.taskId !== binding.taskId
+        ? session.append('session/plugin-task-bound', binding, { ignorable: true }) : existing
+      this.ctx.sessionTitle.setTaskTitle(session, SessionTitleProviderId('plugin-task:' + binding.pluginId), confirmed.title, observed,
+        { pluginId: binding.pluginId, projectId: binding.projectId, taskId: binding.taskId, bindingSeq: registration.seq })
+      if (!await this.ctx.sessions.flush(session)) throw new Error('task registration could not be persisted')
+      // Plugin work has no turn/end checkpoint; its history row must survive immediate shutdown.
+      const cache = this.ctx.get('sessionProjectionCache')
+      if (cache) await cache.write(session)
+      const title = this.ctx.sessionTitle.get(session)
+      if (title === undefined) throw new Error('task title could not be restored')
+      return { registered: true as const, title: title.title, manualTitlePreserved: title.source.kind === 'user' }
+    })
+    const settled = work.then(() => undefined, () => undefined)
+    this.queues.set(binding.sessionId, settled)
+    try { return await work } finally { if (this.queues.get(binding.sessionId) === settled) this.queues.delete(binding.sessionId) }
+  }
+}
