+import { describe, expect, it } from 'vitest'
+import type { SessionFormatArtifact, SessionFormatEvent, SessionFormatHeader, SessionFormatMigrationContext } from '@deepseek-ai/dsh-session-format'
+import { releasedV5SessionFormatCodec, restoreReleasedV5Artifact, sessionFormatV4ToV5 } from '../src/index.ts'
+
+const header: SessionFormatHeader = { version: 5, id: 'TEST_ONLY_session', createdAt: 1, isSeeded: false, delegationDepth: 0, cwd: '/TEST_ONLY' }
+const binding: SessionFormatEvent = { type: 'session/plugin-task-bound', seq: 0, time: 1, ignorable: true,
+  data: { pluginId: 'TEST_ONLY', workspaceId: 'w', sessionId: header.id, projectId: 'p', taskId: 't' } }
+const title: SessionFormatEvent = { type: 'session/title', seq: 1, time: 2,
+  data: { title: 'TEST_ONLY paper', messageSeqs: [], source: { kind: 'provider', provider: 'plugin-task:TEST_ONLY', task: { pluginId: 'TEST_ONLY', projectId: 'p', taskId: 't', bindingSeq: 0 } } } }
+const vocabulary = new Set([binding.type, title.type, 'session/end-seed', 'session-log-deepseek/delivery-accepted'])
+const artifact = (events = [binding, title]): SessionFormatArtifact => ({ header, events, inheritedEventCount: 0 })
+
+describe('V5 registered task titles and adjacent V4 restoration', () => {
+  it('restores a provider task title without any human message and retains original bytes and ownership', () => {
+    const original = artifact(), before = JSON.stringify(original)
+    expect(restoreReleasedV5Artifact(original, vocabulary)).toBe(original)
+    expect(JSON.stringify(original)).toBe(before)
+  })
+  it('rejects an ordinary provider title without human references', () => {
+    const invalid: SessionFormatEvent = { ...title, data: { title: 'TEST_ONLY bad', messageSeqs: [], source: { kind: 'provider', provider: 'ordinary' } } }
+    expect(() => restoreReleasedV5Artifact(artifact([binding, invalid]), vocabulary)).toThrow('messageSeqs')
+  })
+  it.each(['binding', 'project', 'task', 'plugin', 'model'] as const)('rejects forged %s ownership', (field) => {
+    const source = { kind: 'provider', provider: field === 'plugin' ? 'plugin-task:OTHER' : 'plugin-task:TEST_ONLY',
+      task: { pluginId: 'TEST_ONLY', projectId: field === 'project' ? 'OTHER' : 'p', taskId: field === 'task' ? 'OTHER' : 't', bindingSeq: field === 'binding' ? 1 : 0 },
+      ...(field === 'model' ? { model: { provider: 'FAKE', model: 'never-called' } } : {}) }
+    expect(() => restoreReleasedV5Artifact(artifact([binding, { ...title, data: { title: 'TEST_ONLY bad', messageSeqs: [], source } }]), vocabulary)).toThrow()
+  })
+  it('rejects a binding for another native session and an unmarked binding', () => {
+    expect(() => restoreReleasedV5Artifact(artifact([{ ...binding, data: { ...binding.data as object, sessionId: 'OTHER' } }, title]), vocabulary)).toThrow('binding')
+    const unmarked = { ...binding }; delete unmarked['ignorable']
+    expect(() => restoreReleasedV5Artifact(artifact([unmarked, title]), vocabulary)).toThrow('binding')
+  })
+  it('preserves a legitimate ancestor binding and task title inside a seeded fork', () => {
+    const inherited: SessionFormatEvent = { type: 'session/end-seed', seq: 2, time: 3, data: { inherited: true } }
+    const fork: SessionFormatArtifact = { header: { ...header, id: 'TEST_ONLY_child', parentSession: header.id, isSeeded: true }, inheritedEventCount: 2, events: [binding, title, inherited] }
+    expect(restoreReleasedV5Artifact(fork, vocabulary)).toBe(fork)
+  })
+  it('encodes a real V5 header, retains row framing, and rejects a V4 header at native entry', () => {
+    const encoded = releasedV5SessionFormatCodec.encodeHeader(header, 0)
+    expect(encoded['version']).toBe(5)
+    expect(releasedV5SessionFormatCodec.decodeHeader(encoded).version).toBe(5)
+    expect(() => releasedV5SessionFormatCodec.decodeHeader({ ...encoded, version: 4 })).toThrow('v5')
+    expect(releasedV5SessionFormatCodec.encodeEvent(title)['type']).toBe(title.type)
+  })
+  it('streams V4 data into a new header, preserving coordinates and opaque collisions', () => {
+    const old = { ...header, version: 4 }, output: SessionFormatEvent[] = []
+    const stage = sessionFormatV4ToV5.createStage({ sourceHeader: old, targetHeader: sessionFormatV4ToV5.migrateHeader(old), sourceKind: 'decoded', sourceInheritedEventCount: 0 })
+    const context: SessionFormatMigrationContext = { emitEvent: event => output.push(event), emitRun: run => output.push(...run.expand()) }
+    stage.transformEvent(binding, context)
+    const pinned: SessionFormatEvent = { ...title, data: { title: 'TEST_ONLY manual', messageSeqs: [], source: { kind: 'user' } } }
+    stage.transformRun({ runType: 'TEST_ONLY', firstSeq: 1, eventCount: 1, expand: function* () { yield pinned } }, context)
+    expect(output[0]?.type).toBe('external/v4/session/plugin-task-bound')
+    expect(output[0]?.data).toBe(binding.data); expect(output[1]).toBe(pinned)
+    expect(stage.finish(context)).toBe(0)
+  })
+  it('refuses native task title syntax in a V4 source instead of laundering malformed data', () => {
+    const old = { ...header, version: 4 }, stage = sessionFormatV4ToV5.createStage({ sourceHeader: old, targetHeader: header, sourceKind: 'decoded', sourceInheritedEventCount: 0 })
+    expect(() =>{  stage.transformEvent(title, { emitEvent() {}, emitRun() {} }) }).toThrow('V4 source')
+  })
+  it('round trips the native decoder without changing event or seed coordinates', () => {
+    const decoder = releasedV5SessionFormatCodec.createDecoder(releasedV5SessionFormatCodec.encodeHeader(header, 0), 'strict')
+    const rows: SessionFormatEvent[] = [], context: SessionFormatMigrationContext = {
+      emitEvent: event => rows.push(event), emitRun: run => rows.push(...run.expand()),
+    }
+    for (const event of [binding, title]) decoder.decodeRow(releasedV5SessionFormatCodec.encodeEvent(event), context)
+    expect(decoder.header.version).toBe(5); expect(decoder.finish(context)).toBe(0); expect(rows).toEqual([binding, title])
+  })
+  it.each([null, false, 'opaque'])('retains uninterpreted ignorable scalar data (%s)', (data) => {
+    const event: SessionFormatEvent = { type: 'future/opaque', seq: 0, time: 1, ignorable: true, data }
+    expect(restoreReleasedV5Artifact(artifact([event]), new Set()).events[0]).toBe(event)
+    const stage = sessionFormatV4ToV5.createStage({ sourceHeader: { ...header, version: 4 }, targetHeader: header, sourceKind: 'decoded', sourceInheritedEventCount: undefined })
+    const rows: SessionFormatEvent[] = [], context: SessionFormatMigrationContext = { emitEvent: event => rows.push(event), emitRun() {} }
+    stage.transformEvent(event, context); expect(stage.finish(context)).toBe(0); expect(rows[0]).toBe(event)
+  })
+  it('maps active delivery watermarks to the new generation and validates native delivery ownership', () => {
+    const current: SessionFormatEvent = { type: 'session-log-deepseek/delivery-accepted', seq: 1, time: 2, data: { sessionFormatVersion: 5, sessionId: header.id, throughSeq: 0 } }
+    expect(restoreReleasedV5Artifact(artifact([binding, current]), vocabulary).events[1]).toBe(current)
+    const stage = sessionFormatV4ToV5.createStage({ sourceHeader: { ...header, version: 4 }, targetHeader: header, sourceKind: 'decoded', sourceInheritedEventCount: 0 })
+    const rows: SessionFormatEvent[] = [], context: SessionFormatMigrationContext = { emitEvent: event => rows.push(event), emitRun() {} }
+    stage.transformEvent({ ...current, data: { sessionFormatVersion: 4, sessionId: header.id, throughSeq: 0 } }, context)
+    stage.transformEvent({ ...current, data: { sessionFormatVersion: 3, sessionId: header.id, throughSeq: 0 } }, context)
+    expect(rows.map(event => event.data)).toEqual([
+      { sessionFormatVersion: 5, sessionId: header.id, throughSeq: 0 },
+      { sessionFormatVersion: 3, sessionId: header.id, throughSeq: 0 },
+    ])
+  })
+  it.each([null, { ...(binding.data as object), extra: true }, { ...(binding.data as object), pluginId: '' }])('rejects malformed persisted task registration', (data) => {
+    expect(() => restoreReleasedV5Artifact(artifact([{ ...binding, data }]), vocabulary)).toThrow('binding')
+  })
+  it.each([null, false, { kind: 'provider' }])('keeps ordinary title validation strict for source %s', (source) => {
+    expect(() => restoreReleasedV5Artifact(artifact([{ ...title, seq: 0, data: { title: 'TEST_ONLY', messageSeqs: [], source } }]), vocabulary)).toThrow()
+  })
+  it('requires the cited event to be a registration, never an opaque event with similar data', () => {
+    expect(() => restoreReleasedV5Artifact(artifact([{ ...binding, type: 'future/opaque' }, title]), vocabulary)).toThrow('registration')
+  })
+  it('preserves valid V4 titles, rejects empty ordinary providers and derives an inherited cut at EOF', () => {
+    const stage = sessionFormatV4ToV5.createStage({ sourceHeader: { ...header, version: 4, isSeeded: true }, targetHeader: { ...header, isSeeded: true }, sourceKind: 'decoded', sourceInheritedEventCount: undefined })
+    const rows: SessionFormatEvent[] = [], context: SessionFormatMigrationContext = { emitEvent: event => rows.push(event), emitRun() {} }
+    const valid: SessionFormatEvent = { ...title, data: { title: 'TEST_ONLY', messageSeqs: [0], source: { kind: 'provider', provider: 'ordinary' } } }
