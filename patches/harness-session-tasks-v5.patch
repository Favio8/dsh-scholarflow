+/** V5 retains V4 framing and adds titles owned by earlier confirmed plugin tasks. */
+import { defineSessionFormatMigration, SessionFormatError, isSessionFormatJsonObject } from '@deepseek-ai/dsh-session-format'
+import type { SessionFormatArtifact, SessionFormatCodec, SessionFormatCurrentEncoder, SessionFormatEvent, SessionFormatHeader } from '@deepseek-ai/dsh-session-format'
+import { assertReleasedV4Header, releasedV4SessionFormatCodec, restoreReleasedV4Artifact } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+export { releasedV4SessionFormatCodec } from '@deepseek-ai/dsh-session-format-v3-to-v4'
+
+function physicalV4(value: unknown) {
+  if (!isSessionFormatJsonObject(value) || value['version'] !== 5) throw new SessionFormatError('expected format v5 header')
+  return { ...value, version: 4 }
+}
+
+/**
+ * Validate the V5 header using unchanged released fields.
+ * @param header - untrusted current header.
+ */
+export function assertReleasedV5Header(header: unknown): void { assertReleasedV4Header(physicalV4(header)) }
+
+/** V5 physical rows retain the released V4 encoding; only the header version changes. */
+export const releasedV5SessionFormatCodec = Object.freeze({
+  version: 5,
+  decodeHeader(value: unknown) { return { ...releasedV4SessionFormatCodec.decodeHeader(physicalV4(value)), version: 5 } },
+  createDecoder(value, recovery) {
+    const decoder = releasedV4SessionFormatCodec.createDecoder(physicalV4(value), recovery)
+    return { ...decoder, header: { ...decoder.header, version: 5 } }
+  },
+  encodeHeader(header, inheritedEventCount) {
+    assertReleasedV5Header(header)
+    return { ...releasedV4SessionFormatCodec.encodeHeader({ ...header, version: 4 }, inheritedEventCount), version: 5 }
+  },
+  encodeEvent(event) { return releasedV4SessionFormatCodec.encodeEvent(event) },
+} satisfies SessionFormatCodec & SessionFormatCurrentEncoder)
+
+function validationEvent(event: SessionFormatEvent, artifact: SessionFormatArtifact): SessionFormatEvent {
+  if (event.type === 'session/plugin-task-bound') {
+    const data = event.data
+    if (!isSessionFormatJsonObject(data) || event['ignorable'] !== true
+      || Object.keys(data).some(key => !['pluginId', 'workspaceId', 'sessionId', 'projectId', 'taskId'].includes(key))
+      || ['pluginId', 'workspaceId', 'sessionId', 'projectId', 'taskId'].some(key => typeof data[key] !== 'string' || !data[key])
+      || event.seq >= artifact.inheritedEventCount && data['sessionId'] !== artifact.header.id) throw new SessionFormatError('invalid confirmed plugin task binding')
+  }
+  if (!isSessionFormatJsonObject(event.data)) return event
+  if (event.type === 'session-log-deepseek/delivery-accepted' && event.data['sessionFormatVersion'] === 5) {
+    return { ...event, data: { ...event.data, sessionFormatVersion: 4 } }
+  }
+  if (event.type !== 'session/title') return event
+  const source = event.data['source']
+  if (!isSessionFormatJsonObject(source) || source['kind'] !== 'provider' || source['task'] === undefined) return event
+  const owner = source['task']
+  if (Object.keys(source).some(key => !['kind', 'provider', 'task'].includes(key))
+    || !isSessionFormatJsonObject(owner) || Object.keys(owner).some(key => !['pluginId', 'projectId', 'taskId', 'bindingSeq'].includes(key))
+    || typeof owner['pluginId'] !== 'string' || !owner['pluginId'] || typeof owner['projectId'] !== 'string' || !owner['projectId']
+    || typeof owner['taskId'] !== 'string' || !owner['taskId'] || source['provider'] !== 'plugin-task:' + owner['pluginId']
+    || !Number.isSafeInteger(owner['bindingSeq']) || typeof owner['bindingSeq'] !== 'number' || owner['bindingSeq'] < 0 || owner['bindingSeq'] >= event.seq
+    || !Array.isArray(event.data['messageSeqs']) || event.data['messageSeqs'].length !== 0) throw new SessionFormatError('invalid plugin task title owner')
+  const binding = artifact.events[owner['bindingSeq']]
+  if (binding?.type !== 'session/plugin-task-bound' || binding['ignorable'] !== true || !isSessionFormatJsonObject(binding.data)
+    || binding.data['pluginId'] !== owner['pluginId'] || binding.data['projectId'] !== owner['projectId'] || binding.data['taskId'] !== owner['taskId']
+    || binding.seq >= artifact.inheritedEventCount && binding.data['sessionId'] !== artifact.header.id) {
+    throw new SessionFormatError('plugin title has no matching earlier task registration')
+  }
+  // Reuse unchanged V4 relationships through a validation-only view; persisted source is untouched.
+  return { ...event, data: { ...event.data, source: { kind: 'user' } } }
+}
+
+/**
+ * Validate native V5 data, including plugin ownership, then retain the original artifact.
+ * @param artifact - complete detached V5 data.
+ * @param knownEventTypes - installed reader vocabulary.
+ * @returns the validated original artifact.
+ */
+export function restoreReleasedV5Artifact(artifact: SessionFormatArtifact, knownEventTypes: ReadonlySet<string>): SessionFormatArtifact {
+  assertReleasedV5Header(artifact.header)
+  restoreReleasedV4Artifact({
+    ...artifact, header: { ...artifact.header, version: 4 },
+    events: artifact.events.map(event => validationEvent(event, artifact)),
+  }, knownEventTypes)
+  return artifact
+}
+
+function migrateEvent(event: SessionFormatEvent): SessionFormatEvent {
+  // V4 did not own this vocabulary; preserve an old ignorable extension as opaque data.
+  if (event.type === 'session/plugin-task-bound') {
+    if (event['ignorable'] !== true) throw new SessionFormatError('V4 source contains an unknown required plugin task event')
+    return { ...event, type: 'external/v4/session/plugin-task-bound' }
+  }
+  if (!isSessionFormatJsonObject(event.data)) return event
+  if (event.type === 'session/title') {
+    const source = event.data['source'], messages = event.data['messageSeqs']
+    if (isSessionFormatJsonObject(source) && (source['task'] !== undefined
+      || source['kind'] !== 'user' && Array.isArray(messages) && messages.length === 0)) {
+      throw new SessionFormatError('V4 source cannot contain a native V5 plugin title')
+    }
+  }
+  return event.type === 'session-log-deepseek/delivery-accepted' && event.data['sessionFormatVersion'] === 4
+    ? { ...event, data: { ...event.data, sessionFormatVersion: 5 } } : event
+}
+
+/** Adjacent streaming migration preserves event positions and inherited cuts. */
+export const sessionFormatV4ToV5 = defineSessionFormatMigration({
+  name: '@deepseek-ai/dsh-session-format-v4-to-v5', fromVersion: 4, toVersion: 5,
+  migrateHeader(header: SessionFormatHeader) { assertReleasedV4Header(header); return { ...header, version: 5 } },
+  validateTargetHeader: assertReleasedV5Header,
+  createStage(input) {
+    let inherited = input.sourceInheritedEventCount
+    return {
+      ...(inherited === undefined ? {} : { headerInheritedEventCount: inherited }),
+      transformEvent(event, context) {
+        if (event.type === 'session/end-seed' && isSessionFormatJsonObject(event.data) && event.data['inherited'] === true) inherited = event.seq
+        context.emitEvent(migrateEvent(event))
+      },
+      transformRun(run, context) {
+        for (const event of run.expand()) {
+          if (event.type === 'session/end-seed' && isSessionFormatJsonObject(event.data) && event.data['inherited'] === true) inherited = event.seq
+          context.emitEvent(migrateEvent(event))
+        }
+      },
+      finish() { return inherited ?? 0 },
+    }
+  },
+})
